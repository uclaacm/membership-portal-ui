{
	"transform": {
		"^.+\\.jsx?$": ["babel-jest", { "presets": [["next/babel", { "preset-react": { "runtime": "automatic" } }]] }]
	},
	"moduleNameMapper": { "^@/(.*)$": "<rootDir>/$1" },
	"modulePaths": ["<rootDir>/src"],
	"testRegex": "tests/.*\\.tests?\\.(js|ts)x?$",
	"moduleFileExtensions": [
		"ts",
		"tsx",
		"js",
		"jsx",
		"json",
		"node"
	]
}
